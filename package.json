{
  "name": "svitlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.types.json",
    "test": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test --test-coverage-include='.test-build/src/db/utils/**/*.js' .test-build/tests/*.test.js .test-build/src/utils/*/*.spec.js .test-build/src/utils/*/*/*.spec.js .test-build/src/db/utils/*/*.spec.js",
    "test:e2e": "playwright test",
    "test:db-utils": "tsc -p tsconfig.test.json && node --test .test-build/src/db/utils/*/*.spec.js",
    "test:db-utils:coverage": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test --test-coverage-include='.test-build/src/db/utils/**/*.js' .test-build/src/db/utils/*/*.spec.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs": "^10.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "storybook": "^10.6.3",
    "typescript": "^5"
  }
}
