{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "incremental": false,
    "isolatedModules": false,
    "plugins": []
  },
  "include": [
    "src/data/skillsTaxonomy/__tests__/*.spec.ts",
    "src/db/utils/**/*.spec.ts",
    "src/db/controllers/__tests__/controllers.integration.test.ts",
    "src/db/controllers/**/*.spec.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build"
  ]
}
