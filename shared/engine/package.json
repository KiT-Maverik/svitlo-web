{
  "name": "@svitlo/engine",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./localization": {
      "types": "./dist/localization.d.ts",
      "default": "./dist/localization.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy.d.ts",
      "default": "./dist/taxonomy.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "default": "./dist/builders.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "default": "./dist/generation.js"
    },
    "./assessment-methods": {
      "types": "./dist/assessment-methods.d.ts",
      "default": "./dist/assessment-methods.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/utils/builders/*/*.spec.js .test-build/utils/createDynamicQuestion/*.spec.js .test-build/utils/createTextResource/*.spec.js .test-build/utils/createLocalizedFileLocations/*.spec.js .test-build/data/assessmentMethodTaxonomy/*.spec.js"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  },
  "typesVersions": {
    "*": {
      "localization": [
        "dist/localization.d.ts"
      ],
      "taxonomy": [
        "dist/taxonomy.d.ts"
      ],
      "content": [
        "dist/content.d.ts"
      ],
      "builders": [
        "dist/builders.d.ts"
      ],
      "generation": [
        "dist/generation.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "assessment-methods": [
        "dist/assessment-methods.d.ts"
      ]
    }
  },
  "dependencies": {
    "@svitlo/contracts": "0.0.0"
  }
}
